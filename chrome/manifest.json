{
  "manifest_version": 3,
  "name": "Quill",
  "version": "2.0",
  "description": "Fill, auto-fill or sign the PDF in this tab with Quill on your computer.",
  "key": "",
  "action": { "default_title": "Quill", "default_popup": "popup.html", "default_icon": "icon.png" },
